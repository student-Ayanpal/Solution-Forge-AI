# ==========================================
# Solution-Forge-AI - environment template
# Copy this file to `.env` and fill real values.
# `.env` is gitignored. Never commit real keys to GitHub.
# ==========================================

# MongoDB Atlas connection string (your cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB=db_name

# JWT secret for login tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=jwt__algorithm
JWT_EXPIRY_MINUTES=token_expiry_time

# Cohere LLM key (powers the CrewAI agents)
COHERE_API_KEY=

# Gemini LLM key (powers the Technology Advisor agent)
GEMINI_API_KEY=

# Serper.dev key (optional; powers agent web search)
SERPER_API_KEY=